# Copy to platform/.env for local (non-docker) runs. docker-compose.yml
# already injects the container-network equivalents of the DB/Redis/MinIO
# vars below, so this file mainly matters for MODEL_PROVIDER / API keys and
# for running a service directly on the host (outside docker compose).

DATABASE_URL=postgresql+psycopg2://reo:reo@localhost:5432/reo
ASYNC_DATABASE_URL=postgresql+asyncpg://reo:reo@localhost:5432/reo
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=reo-minio
S3_SECRET_KEY=reo-minio-secret

# mock (default, zero-cost, deterministic) | anthropic | openai
MODEL_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

JWT_SECRET=dev-only-change-me-in-every-real-deployment
VAULT_MASTER_KEY=y2N4x8dGm4KxG3nq6z2m3sVfR8k1cQ2s1r7pR9lY1yE=

DATA_WATCH_DIR=/data
ENVIRONMENT=local
