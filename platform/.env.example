# Copy to platform/.env for local (non-docker) runs. docker-compose.yml
# already injects the container-network equivalents of the DB/Redis/object-
# storage vars below, so this file mainly matters for MODEL_PROVIDER / API
# keys and for running a service directly on the host (outside docker
# compose).

DATABASE_URL=postgresql+psycopg2://reo:reo@localhost:5432/reo
ASYNC_DATABASE_URL=postgresql+asyncpg://reo:reo@localhost:5432/reo
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=reo-minio
S3_SECRET_KEY=reo-minio-secret

# openrouter (default — one OpenAI-compatible endpoint in front of many
# providers/models, https://openrouter.ai) | anthropic | openai |
# mock (zero-cost, deterministic; automatic fallback when the configured
# provider has no API key, so a fresh clone with this file as-is still runs)
MODEL_PROVIDER=openrouter

# Get a key at https://openrouter.ai/settings/keys — this file is never
# committed (see .gitignore), copy it to platform/.env or
# platform/infrastructure/.env and fill this in for real agent reasoning
# instead of the mock fallback. Or run infrastructure/set_api_key.sh instead
# of editing this by hand.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Renewable Energy Orchestrator

# Direct-provider alternatives (set MODEL_PROVIDER=anthropic or openai to use)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Token-conservation guardrail: a per-tenant Redis-backed cap enforced
# before any provider call is made (blocked calls spend zero tokens).
# Ignored for MODEL_PROVIDER=mock.
MODEL_RATE_LIMIT_PER_MINUTE=20
MODEL_RATE_LIMIT_PER_DAY=2000

# Model gateway circuit breaker (guardrails/circuit_breaker.py) — these are
# only the *first-ever* defaults for a tenant's PlatformSettings row; once
# created, Configuration Studio's own per-tenant values take over and these
# env vars have no further effect for that tenant.
MODEL_GATEWAY_CIRCUIT_BREAKER_ENABLED_DEFAULT=true
MODEL_GATEWAY_TIMEOUT_SECONDS_DEFAULT=30.0
MODEL_GATEWAY_CIRCUIT_FAILURE_THRESHOLD_DEFAULT=3
MODEL_GATEWAY_CIRCUIT_COOLDOWN_SECONDS_DEFAULT=60

JWT_SECRET=dev-only-change-me-in-every-real-deployment
VAULT_MASTER_KEY=y2N4x8dGm4KxG3nq6z2m3sVfR8k1cQ2s1r7pR9lY1yE=

# Real external OIDC identity provider (see docker-compose.yml's bundled
# Keycloak container and docs/DEPLOYMENT.md's SSO section). OIDC_ISSUER is
# the container-network base URL the api process calls server-to-server;
# OIDC_AUTHORIZE_URL_PUBLIC is the host-reachable equivalent the browser is
# actually redirected to — the same public/private split as the S3 vars
# above, for the same reason. Leave OIDC_ISSUER unset to disable SSO
# entirely (Configuration Studio's sso_enabled toggle then has no effect).
OIDC_ISSUER=http://keycloak:8080/realms/reo
OIDC_AUTHORIZE_URL_PUBLIC=http://localhost:8081/realms/reo/protocol/openid-connect/auth
OIDC_CLIENT_ID=reo-platform
OIDC_CLIENT_SECRET=reo-platform-secret
OIDC_REDIRECT_URI=http://localhost:8000/auth/sso/callback
FRONTEND_BASE_URL=http://localhost:5173

DATA_WATCH_DIR=/data
ENVIRONMENT=local
